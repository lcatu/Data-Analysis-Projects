    <DTS:Executable
      DTS:refId="Package\Load AGG_SALES_DAILY"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{811C6F9B-A8B8-4127-9DDB-6E67799AD817}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load AGG_SALES_DAILY"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A23E4056-03BE-4A1E-B37F-213178FA50F5}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE dbo.AGG_SALES_DAILY;&#xA;&#xA;INSERT INTO dbo.AGG_SALES_DAILY (&#xA;    date_key,&#xA;    total_quantity_sold,&#xA;    total_tax_amount,&#xA;    total_revenue,&#xA;    total_profit,&#xA;    avg_order_value,&#xA;    count_invoices,&#xA;    count_distinct_products&#xA;)&#xA;SELECT&#xA;    date_key,&#xA;    SUM(quantity)                    AS total_quantity_sold,&#xA;    SUM(tax_amount)                  AS total_tax_amount,&#xA;    SUM(total_including_tax)         AS total_revenue,&#xA;    SUM(line_profit)                 AS total_profit,&#xA;    AVG(total_including_tax)         AS avg_order_value,&#xA;    COUNT(DISTINCT wwi_invoice_id)   AS count_invoices,&#xA;    COUNT(DISTINCT product_key)      AS count_distinct_products&#xA;FROM dbo.FACT_SALES&#xA;GROUP BY date_key" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load AGG_SALES_PRODUCT_CITY_DAILY"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0F6F4396-8710-496A-869A-D72FC2E32BF4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load AGG_SALES_PRODUCT_CITY_DAILY"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A23E4056-03BE-4A1E-B37F-213178FA50F5}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE dbo.AGG_SALES_PRODUCT_CITY_DAILY &#xA;&#xA;INSERT INTO dbo.AGG_SALES_PRODUCT_CITY_DAILY (&#xA;    date_key,&#xA;    product_key,&#xA;    city_key,&#xA;    total_quantity_sold,&#xA;    total_revenue,&#xA;    total_profit,&#xA;    total_order&#xA;)&#xA;SELECT&#xA;    date_key,&#xA;    product_key,&#xA;    city_key,&#xA;    SUM(quantity)               AS total_quantity_sold,&#xA;    SUM(total_including_tax)    AS total_revenue,&#xA;    SUM(line_profit)            AS total_profit,&#xA;    COUNT(DISTINCT wwi_invoice_id)  AS total_order&#xA;FROM dbo.FACT_SALES&#xA;GROUP BY date_key, product_key, city_key" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
