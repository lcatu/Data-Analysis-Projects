                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	si.StockItemID as wwi_stock_item_id
	, sg.StockGroupID as wwi_group_id
FROM Warehouse.StockItems si 
	JOIN Warehouse.StockItemStockGroups sist on sist.StockItemID = si.StockItemID
	JOIN Warehouse.StockGroups sg on sist.StockGroupID = sg.StockGroupID
ORDER BY wwi_stock_item_id</property>
